+
+package lsmkv
+
+import "sync/atomic"
+
+// Diag counts what the reads of a collection bucket consult, for the
+// diagnostic of the inserts of the posting-edge index (bench-report.md of
+// feat/posting-edge-index, "Pasada de diagnóstico del insert"). It counts
+// nothing unless On is set, which only that harness does, and it is on the
+// diagnostic branch alone.
+var Diag struct {
+	On atomic.Bool
+	// Reads counts the reads of a key from the segments of a bucket, Held
+	// the segments the bucket had at each of them, added up, and Found
+	// those that held the key. BloomFalse counts the segments whose Bloom
+	// filter let through a key they did not hold.
+	Reads, Held, Found, BloomFalse atomic.Int64
+}
+
+// diagRead counts one read of a key from the segments of a bucket.
+func diagRead(held, found int) {
+	if Diag.On.Load() {
+		Diag.Reads.Add(1)
+		Diag.Held.Add(int64(held))
+		Diag.Found.Add(int64(found))
+	}
+}
