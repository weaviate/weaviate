diff --git a/adapters/repos/db/vector/postingedge/persistent_clocks.go b/adapters/repos/db/vector/postingedge/persistent_clocks.go
new file mode 100644
index 0000000000..c203200652
--- /dev/null
+++ b/adapters/repos/db/vector/postingedge/persistent_clocks.go
@@ -0,0 +1,110 @@
+//                           _       _
+// __      _____  __ ___   ___  __ _| |_ ___
+// \ \ /\ / / _ \/ _` \ \ / / |/ _` | __/ _ \
+//  \ V  V /  __/ (_| |\ V /| | (_| | ||  __/
+//   \_/\_/ \___|\__,_| \_/ |_|\__,_|\__\___|
+//
+//  Copyright © 2016 - 2026 Weaviate B.V. All rights reserved.
+//
+//  CONTACT: hello@weaviate.io
+//
+
+package postingedge
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+// The clocks of the inserts, for the diagnostic of where the time of a caller
+// goes (bench-report.md of feat/posting-edge-index, "Pasada de diagnóstico
+// del insert"). There are none unless the config of the index brings them,
+// which only that harness does. They are on the diagnostic branch alone.
+
+// insertClock names a part of the time a caller spends in AddBatch once the
+// index has its base. What no part covers is the rest of the call.
+type insertClock int
+
+const (
+	// clockAdmitWait is the wait for the write lock of the index to check
+	// the batch, and clockAdmit the check.
+	clockAdmitWait insertClock = iota
+	clockAdmit
+	// clockEnterWait is the wait to start the searches of a window while a
+	// batch is applied, and clockReadWait the wait for the index for
+	// reading.
+	clockEnterWait
+	clockReadWait
+	// clockPlans is the plans of a window: the centroids and the search of
+	// every one of its vectors, whose parts growStats has.
+	clockPlans
+	// clockLeaveWait is the wait for the lock of the batches to leave the
+	// plans of a window.
+	clockLeaveWait
+	// Of the caller that applies a batch: the wait for the searches that
+	// run to end, the wait for the index for writing, the writes of the
+	// batch with their record of the journal, and what follows them.
+	clockDrainWait
+	clockApplyLockWait
+	clockApply
+	clockApplyAfter
+	// clockAppliedWait is the wait of a caller for the plans it left to be
+	// applied.
+	clockAppliedWait
+	insertClockCount
+)
+
+var insertClockNames = [insertClockCount]string{
+	clockAdmitWait:     "admitWaitNs",
+	clockAdmit:         "admitNs",
+	clockEnterWait:     "enterWaitNs",
+	clockReadWait:      "readWaitNs",
+	clockPlans:         "plansNs",
+	clockLeaveWait:     "leaveWaitNs",
+	clockDrainWait:     "drainWaitNs",
+	clockApplyLockWait: "applyLockWaitNs",
+	clockApply:         "applyNs",
+	clockApplyAfter:    "applyAfterNs",
+	clockAppliedWait:   "appliedWaitNs",
+}
+
+// insertClocks adds up, over every caller, the parts of their calls.
+type insertClocks struct {
+	ns [insertClockCount]atomic.Int64
+	// total is the time of the calls of AddBatch that went in batches,
+	// start to end, and calls how many they were. windows counts their
+	// windows and plans the plans of those; batches the batches applied and
+	// batchPlans the plans they had.
+	total, calls, windows, plans, batches, batchPlans atomic.Int64
+}
+
+// start reads the clock, where there are clocks.
+func (c *insertClocks) start() time.Time {
+	if c == nil {
+		return time.Time{}
+	}
+	return time.Now()
+}
+
+// lap adds to a clock the time since the reading it is given, and returns a
+// new one.
+func (c *insertClocks) lap(which insertClock, since time.Time) time.Time {
+	if c == nil {
+		return since
+	}
+	now := time.Now()
+	c.ns[which].Add(int64(now.Sub(since)))
+	return now
+}
+
+// snapshot returns what the clocks have added up so far.
+func (c *insertClocks) snapshot() map[string]int64 {
+	out := map[string]int64{
+		"totalNs": c.total.Load(), "calls": c.calls.Load(), "windows": c.windows.Load(), "plans": c.plans.Load(),
+		"batches": c.batches.Load(), "batchPlans": c.batchPlans.Load(),
+	}
+	for i := range c.ns {
+		out[insertClockNames[i]] = c.ns[i].Load()
+	}
+	return out
+}
